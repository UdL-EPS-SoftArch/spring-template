@startuml

class User extends UriEntity implements UserDetails {
  username : String
  fullName : String
  email : String
  password : String
  admin : boolean
}

class Category extends UriEntity {
  id : Long
  name : String
}

class Subcategory extends UriEntity {
  id : Long
  name : String
}

class Event extends UriEntity {
  id : Long
  title : String
  description : String
  address : String
  dateTime : LocalDateTime
  maxParticipants : Integer
  estimatedCost : BigDecimal
  created : Instant
  modified : Instant
}

class Record extends UriEntity {
  id : Long
  name : String
  description : String
  status : Status
  created : Instant
  modified : Instant
}

class Comment extends UriEntity {
  id : Long
  content : String
  createdAt : Instant
}

class UriEntity {
  uri : String
  version : Long
}

Category "1" -- "0..*" Subcategory : contains
Subcategory "1" -- "0..*" Event : classifies
User "1" -- "0..*" Event : creates
Event "0..*" -- "0..*" User : participants
Event "1" -- "0..*" Comment : has comments
User "1" -- "0..*" Comment : writes
User "1" -- "0..*" Record : owns

@enduml
