@startuml

interface UserDetails

abstract class UriEntity {
  uri : String
  version : Long
}

class User extends UriEntity implements UserDetails {
  username : String <<id>>
  fullName : String
  email : String
  password : String <<write-only>>
  admin : boolean <<read-only>>
  suspended : boolean <<read-only>>
}

class Category extends UriEntity {
  id : Long
  name : String
}

class Subcategory extends UriEntity {
  id : Long
  name : String
}

class Event extends UriEntity {
  id : Long
  title : String
  description : String <<max 500>>
  address : String
  dateTime : LocalDateTime
  maxParticipants : Integer <<> 0>>
  estimatedCost : BigDecimal <<>= 0>>
  created : Instant
  modified : Instant
}

class Comment extends UriEntity {
  id : Long
  content : String
  createdAt : Instant
}

class Report extends UriEntity {
  id : Long
  createdAt : Instant
}

class Record extends UriEntity {
  id : Long
  name : String
  description : String
  status : Status
  created : Instant
  modified : Instant
}

enum Status {
  PUBLIC
  PRIVATE
}

Category "1" -- "0..*" Subcategory : contains
Subcategory "1" -- "0..*" Event : classifies
User "1" -- "0..*" Event : creator
Event "0..*" -- "0..*" User : participants
Event "1" -- "0..*" Comment : comments
User "1" -- "0..*" Comment : author
User "1" -- "0..*" Record : ownedBy
User "1" -- "0..*" Report : reporter
Event "0..1" -- "0..*" Report : reported event
Comment "0..1" -- "0..*" Report : reported comment
Record --> Status

note "A report targets exactly one\nevent or one comment.\nUnique per (reporter, target)." as N1
Report .. N1

@enduml
